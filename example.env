# Telegram API Credentials
# 1. Go to https://my.telegram.org/apps and log in
# 2. Create a new application to get APP_ID and APP_HASH
# 3. Go to @BotFather on Telegram to create a bot and get BOT_TOKEN
APP_ID=
APP_HASH=
BOT_TOKEN=

# Twitter Credentials (Required for Twitter functionality)
# Get these from https://developer.twitter.com/
CONSUMER_KEY=your_consumer_key
CONSUMER_SECRET=your_consumer_secret
ACCESS_KEY=your_access_key
ACCESS_SECRET=your_access_secret

# Channel and Group IDs (Optional)
# Leave empty if you only want to use Twitter
# Get IDs by forwarding a message from channel/group to @userinfobot
CONFIG_CHANNEL_ID=  # e.g., -1001234567890
CHANNEL_ID=        # e.g., -1001234567891
GROUP_ID=          # e.g., -1001234567892
SOURCE_CHANNEL_ID= # e.g., -1001234567893

# Social Media Settings
GROUP=            # Group name/link to append to messages
CHANNEL_URL=      # Channel URL to append to tweets
DISCUSSION_GROUP=  # Discussion group name to append to messages
DISCUSSION_GROUP_URL= # Discussion group URL to append to tweets
TWITTER_URL=      # Twitter profile URL

# Optional Channel/Group Settings
GROUP_TOPIC_ID=   # Message ID for group topic

# Message Settings
TWEET_LENGTH=280  # Maximum tweet length (default 280)
ALLOW_USERS=      # Comma-separated list of allowed user IDs

# Debug Settings (Optional)
DEBUG=0           # Set to 1 to enable debug logging

# Note: All IDs starting with -100 are channel/group IDs
# Regular user IDs are positive numbers
# Get your user ID by sending /start to @userinfobot
